# =============================================================================
# LitigatAI environment
# Copy this file to .env and fill in whatever you have.
# =============================================================================

# --- AI providers ------------------------------------------------------------
# NONE of these is required. With ALLOW_CLIENT_KEYS on (the default), a
# deployment with no keys at all boots fine and each visitor pastes their own
# key in the API keys panel, which is what makes free public hosting workable.
#
# Set a key here to provide a default for every visitor instead. A visitor's
# own key always takes precedence for their own requests.

# Google Gemini            https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq                     https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI                   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face             https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI    https://dash.cloudflare.com/profile/api-tokens
# BOTH are needed. The account id is part of the request URL, so a token on its
# own cannot address anything. The token needs the Workers AI permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Optional model overrides ------------------------------------------------
# The id you name here is moved to the top of the picker for that provider.
# GEMINI_MODEL=gemini-2.5-flash
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Add extra model ids to the picker, comma separated.
# GROQ_EXTRA_MODELS=qwen/qwen3-32b
# OPENAI_EXTRA_MODELS=o4-mini

# Point the OpenAI adapter at any OpenAI compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Bring your own key ------------------------------------------------------
# 1 (default) lets a visitor paste their own provider key in the UI. It is held
# in their browser, sent as a request header, used for their calls only, and
# never stored on the server.
# Set to 0 for a private deployment that must run only on the keys above.
# ALLOW_CLIENT_KEYS=1

# --- Optional: live Indian case law ------------------------------------------
# Register at https://api.indiankanoon.org/ . Without it, Legal Research and
# Authority Check still work and fall back to the model's own knowledge.
INDIAN_KANOON_API_TOKEN=

# --- Optional: durable storage for the case tracker --------------------------
# Without DATABASE_URL the tracker uses SQLite on local disk, which resets when
# a free Render service redeploys. Set a Postgres URL to keep the data.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Optional: tuning --------------------------------------------------------
# MAX_UPLOAD_MB=25
# MAX_OCR_PAGES=8
# REQUEST_TIMEOUT=180
# CORS_ORIGINS=https://your-frontend.example.com
# DEBUG=false
